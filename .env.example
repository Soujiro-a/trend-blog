# ⚠️ 이 파일에는 실제 값을 넣지 마세요. 깃에 올라가는 '예시' 파일입니다.
#
# 실제 값은 이 파일을 복사해서 만든 .env 에만 넣으세요.
#   Windows: copy .env.example .env
#   맥/리눅스: cp .env.example .env
# .env 는 .gitignore 에 있어서 깃에 올라가지 않습니다.
#
# GitHub Actions 로 돌릴 때는 저장소 Secrets 에 같은 이름으로 등록합니다.

# Claude API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# Blogger — scripts/get_blogger_token.py 를 실행하면 네 값이 모두 출력됩니다
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# --- 계정을 더 쓸 때 (함대 accounts: 에 추가한 이름마다) ---
# 이름이 second 라면 아래 세 개를 채웁니다. 발급은:
#   python scripts/get_blogger_token.py --full --from-env --write-env --account second
# BLOGGER_CLIENT_ID_SECOND=
# BLOGGER_CLIENT_SECRET_SECOND=
# BLOGGER_REFRESH_TOKEN_SECOND=

# 블로그 소개·개인정보처리방침 페이지에 들어갈 연락 이메일 (scripts/setup_pages.py)
CONTACT_EMAIL=

# 쿠팡파트너스 (선택) — 없으면 제휴 링크 없이 동작합니다.
# https://partners.coupang.com → 링크 생성 → API 키 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
